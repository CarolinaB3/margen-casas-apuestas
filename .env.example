# Copiá este archivo a .env y completá los valores.
# El .env está en .gitignore: NUNCA se sube a git.

# Airflow
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=

# Minio (object storage intermedio)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# SFTP (simula al proveedor que entrega el CSV de cuotas)
SFTP_USER=proveedor
SFTP_PASSWORD=

# football-data.org (key gratis en https://www.football-data.org/client/register)
FOOTBALL_DATA_API_KEY=

# Snowflake (dbt los lee con env_var() desde profiles.yml)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
