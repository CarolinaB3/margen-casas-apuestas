# Copiá este archivo a .env y completá los valores.
# El .env está en .gitignore: NUNCA se sube a git.

# Airflow
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=
# Clave para firmar sesiones de la UI. Generala con:
#   python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=
# Clave para cifrar Connections y Variables guardadas en la base. Generala con:
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=

# Minio (object storage intermedio)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Usuario que usa Airflow: solo puede leer y escribir en el bucket raw.
# La contraseña debe tener al menos 8 caracteres.
MINIO_PIPELINE_USER=pipeline
MINIO_PIPELINE_PASSWORD=

# SFTP (simula al proveedor que entrega el CSV de cuotas)
SFTP_USER=proveedor
SFTP_PASSWORD=

# football-data.org (key gratis en https://www.football-data.org/client/register)
FOOTBALL_DATA_API_KEY=

# Snowflake (ver sql/setup.sql). El usuario del pipeline entra con llave RSA:
# la llave privada va en secrets/snowflake_rsa_key.p8 (nunca a git).
# SNOWFLAKE_ACCOUNT es el identificador <organizacion>-<cuenta> que muestra Snowsight.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=PIPELINE_USUARIO
SNOWFLAKE_ROLE=PIPELINE_ROL
SNOWFLAKE_WAREHOUSE=APUESTAS_WH
SNOWFLAKE_DATABASE=APUESTAS
